<?php
/**
 * @file
 * Logs in to the Moby app with a code emailed to the user.
 *
 * The app asks for a login with an email address, and the site emails a
 * 6-digit code to the account with that address. The app then asks for the
 * code, as a second step. See "Email login" in moby_docs/API.md.
 */

/**
 * The most codes one IP address may ask for an hour.
 */
define('MOBY_AUTH_EMAIL_IP_LIMIT', 10);

/**
 * The most codes that may be asked for one email address an hour.
 */
define('MOBY_AUTH_EMAIL_MAIL_LIMIT', 5);

/**
 * Implements hook_config_info().
 */
function moby_auth_email_config_info() {
  $prefixes['moby_auth_email.settings'] = array(
    'label' => t('Moby email login settings'),
    'group' => t('Configuration'),
  );
  return $prefixes;
}

/**
 * Implements hook_autoload_info().
 */
function moby_auth_email_autoload_info() {
  return array(
    'MobyAuthEmail' => 'includes/moby_auth_email.class.inc',
  );
}

/**
 * Implements hook_moby_auth_info().
 */
function moby_auth_email_moby_auth_info() {
  $mechanisms['email'] = array(
    'label' => t('Email a login code'),
    'description' => t('Users enter their email address, then the 6-digit code emailed to them.'),
    'class' => 'MobyAuthEmail',
  );
  return $mechanisms;
}

/**
 * Returns how many wrong codes are allowed before a new one must be sent.
 */
function moby_auth_email_max_attempts() {
  return max(1, (int) config_get('moby_auth_email.settings', 'max_attempts') ?: 3);
}

/**
 * Returns how long an emailed code works for, in seconds.
 */
function moby_auth_email_code_lifetime() {
  return max(60, (int) config_get('moby_auth_email.settings', 'code_lifetime') ?: 900);
}

/**
 * Implements hook_mail().
 */
function moby_auth_email_mail($key, &$message, $params) {
  if ($key !== 'login') {
    return;
  }
  $options = array('langcode' => $message['language']->langcode);
  $variables = array(
    '@site' => config_get('system.core', 'site_name'),
    '@name' => user_format_name($params['account']),
    '@device' => $params['device_name'],
    '@code' => $params['code'],
    '@minutes' => round(moby_auth_email_code_lifetime() / 60),
  );
  $message['subject'] = t('@code is your Moby app login code for @site', $variables, $options);
  $message['body'][] = t('Hello @name,', $variables, $options);
  $message['body'][] = t('Someone asked to log in to the Moby app for @site on "@device", with this email address. If that was you, enter this code in the app:', $variables, $options);
  $message['body'][] = $params['code'];
  $message['body'][] = t('The code works once, for @minutes minutes.', $variables, $options);
  $message['body'][] = t('If you didn\'t ask to log in, you can ignore this email. No one can log in without the code.', $variables, $options);
}

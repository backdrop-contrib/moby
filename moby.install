<?php
/**
 * @file
 * Install, update, and uninstall functions for Moby.
 */

/**
 * Implements hook_install().
 */
function moby_install() {
  backdrop_set_message(t('Moby has been installed. <a href="@url">Run the setup wizard</a> to get it ready to post.', array('@url' => url('admin/config/services/moby/setup'))));
}

/**
 * Implements hook_schema().
 */
function moby_schema() {
  $schema['moby_token'] = array(
    'description' => 'API tokens issued to mobile devices.',
    'fields' => array(
      'tid' => array(
        'description' => 'Primary key: unique token ID.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'uid' => array(
        'description' => 'The {users}.uid that owns this token.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'token_hash' => array(
        'description' => 'SHA-256 hash of the token. The token itself is never stored.',
        'type' => 'char',
        'length' => 64,
        'not null' => TRUE,
      ),
      'device_name' => array(
        'description' => 'The name of the device the token was issued to.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'mechanism' => array(
        'description' => 'The authentication mechanism used to obtain the token.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ),
      'created' => array(
        'description' => 'The Unix timestamp when the token was issued.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'last_used' => array(
        'description' => 'The Unix timestamp when the token was last used.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('tid'),
    'unique keys' => array(
      'token_hash' => array('token_hash'),
    ),
    'indexes' => array(
      'uid' => array('uid'),
    ),
    'foreign keys' => array(
      'user' => array(
        'table' => 'users',
        'columns' => array('uid' => 'uid'),
      ),
    ),
  );
  $schema['moby_media'] = array(
    'description' => 'Photos and videos uploaded through the API.',
    'fields' => array(
      'fid' => array(
        'description' => 'The {file_managed}.fid of the uploaded file.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'alt' => array(
        'description' => 'Alt text, copied to the file field item description when the media is attached to a post.',
        'type' => 'text',
        'not null' => FALSE,
      ),
    ),
    'primary key' => array('fid'),
    'foreign keys' => array(
      'file' => array(
        'table' => 'file_managed',
        'columns' => array('fid' => 'fid'),
      ),
    ),
  );
  $schema['moby_post'] = array(
    'description' => 'Posts created through the API with a client ID, to prevent duplicates.',
    'fields' => array(
      'nid' => array(
        'description' => 'The {node}.nid of the post.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'uid' => array(
        'description' => 'The {users}.uid that created the post.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'client_id' => array(
        'description' => 'The UUID generated by the app for the post.',
        'type' => 'char',
        'length' => 36,
        'not null' => TRUE,
      ),
      'created' => array(
        'description' => 'The Unix timestamp when the post was created.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('nid'),
    'unique keys' => array(
      'uid_client_id' => array('uid', 'client_id'),
    ),
    'foreign keys' => array(
      'node' => array(
        'table' => 'node',
        'columns' => array('nid' => 'nid'),
      ),
      'user' => array(
        'table' => 'users',
        'columns' => array('uid' => 'uid'),
      ),
    ),
  );
  return $schema;
}

/**
 * Add the moby_token table and authentication mechanism setting.
 */
function moby_update_1000() {
  if (!db_table_exists('moby_token')) {
    $schema = moby_schema();
    db_create_table('moby_token', $schema['moby_token']);
  }
  $config = config('moby.settings');
  if ($config->get('auth_mechanism') === NULL) {
    $config->set('auth_mechanism', 'password');
    $config->save();
  }
}

/**
 * Add the moby_media table.
 */
function moby_update_1001() {
  if (!db_table_exists('moby_media')) {
    $schema = moby_schema();
    db_create_table('moby_media', $schema['moby_media']);
  }
}

/**
 * Add the moby_post table.
 */
function moby_update_1002() {
  if (!db_table_exists('moby_post')) {
    $schema = moby_schema();
    db_create_table('moby_post', $schema['moby_post']);
  }
}

/**
 * Add the video thumbnail field setting.
 */
function moby_update_1003() {
  $config = config('moby.settings');
  if ($config->get('mapping.media.thumbnail_field') === NULL) {
    $config->set('mapping.media.thumbnail_field', '');
    $config->save();
  }
}

/**
 * Replace the latitude and longitude settings with a Geofield setting.
 *
 * Values already saved in latitude and longitude fields are not moved.
 */
function moby_update_1004() {
  $config = config('moby.settings');
  $location = $config->get('mapping.location');
  $replaced = !empty($location['latitude_field']) || !empty($location['longitude_field']);
  unset($location['latitude_field'], $location['longitude_field']);
  $location += array('name_field' => '', 'coordinates_field' => '');
  $config->set('mapping.location', $location);
  $config->save();
  if ($replaced) {
    return t('Moby no longer saves coordinates in separate latitude and longitude fields. Select a Geofield for the location coordinates in its settings. Coordinates already saved have not been moved.');
  }
}

/**
 * Add the thumbnail image style setting.
 */
function moby_update_1005() {
  $config = config('moby.settings');
  if ($config->get('thumbnail_style') === NULL) {
    $config->set('thumbnail_style', 'large');
    $config->save();
  }
}

/**
 * Add the setting for whether the setup wizard has been run.
 *
 * Sites that have already selected a content type don't need the wizard.
 */
function moby_update_1006() {
  $config = config('moby.settings');
  if ($config->get('setup_complete') === NULL) {
    $config->set('setup_complete', (bool) $config->get('node_type'));
    $config->save();
  }
}

/**
 * Add the tag vocabulary setting, using the "tags" vocabulary if there is one.
 */
function moby_update_1007() {
  $config = config('moby.settings');
  if ($config->get('mapping.tags') !== NULL) {
    return;
  }
  $vocabulary = (module_exists('taxonomy') && taxonomy_vocabulary_load('tags')) ? 'tags' : '';
  $config->set('mapping.tags', array('vocabulary' => $vocabulary));
  $config->save();
  $node_type = $config->get('node_type');
  if ($vocabulary && $node_type && node_type_get_type($node_type)) {
    $field_name = moby_tags_ensure_field($node_type, $vocabulary);
    return t('Tags from the app are now saved in the "Tags" vocabulary, in the %field field.', array('%field' => $field_name));
  }
}

/**
 * Allow more than one authentication mechanism to be enabled.
 */
function moby_update_1008() {
  $config = config('moby.settings');
  if ($config->get('auth_mechanisms') === NULL) {
    $name = $config->get('auth_mechanism');
    $config->set('auth_mechanisms', array($name ? $name : 'password'));
  }
  $config->clear('auth_mechanism');
  $config->save();
}
